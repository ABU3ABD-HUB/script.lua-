--  خانة الإشارة (Prefix)
local remoteSignal = game:GetService("ReplicatedStorage"):WaitForChild("HDAdminHDClient"):WaitForChild("Signals"):WaitForChild("RequestCommand")
local spamConnection = nil

StartButton.MouseButton1Click:Connect(function()
	if spamConnection then return end
	StartButton.Text = "جاري الارسال..."
	
	spamConnection = RunService.Heartbeat:Connect(function()
        local prefix = PrefixInput.Text
		local cmd = CommandInput.Text
		local target = UserInput.Text
		local fullCommand = prefix .. cmd .. " " .. target
		local args = { fullCommand }
		
		for i = 1, 10 do 
			pcall(function()
				remoteSignal:InvokeServer(unpack(args))
			end)
		end
	end)
end)

StopButton.MouseButton1Click:Connect(function()
	if spamConnection then
		spamConnection:Disconnect()
		spamConnection = nil
	end
	StartButton.Text = "بدأ"
end)
