-- خانة
local function createStyledElement(parent, size, position, defaultText, bgColor, isButton)
    local outFrame, grad = createAnimatedOutline(parent, size, position, UDim.new(0, 6))
    table.insert(activeGradients, grad)
    
    local elem = Instance.new(isButton and "TextButton" or "TextBox")
    elem.Parent = outFrame
    elem.Position = UDim2.new(0, 2, 0, 2)
    elem.Size = UDim2.new(1, -4, 1, -4)
    elem.BackgroundColor3 = bgColor
    elem.Text = defaultText
    elem.TextColor3 = Color3.fromRGB(255, 255, 255)
    elem.TextSize = isButton and 16 or 14
    elem.Font = isButton and Enum.Font.SourceSansBold or Enum.Font.SourceSans
    elem.BorderSizePixel = 0
    if not isButton then
        elem.PlaceholderText = defaultText
        if defaultText ~= "-" then
            elem.Text = (defaultText == "nv" or defaultText == "me") and defaultText or ""
        end
    end
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = elem
    
    return elem
end

